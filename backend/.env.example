PORT=5000
NODE_ENV=production

# CORS — explicit allowlist, comma separated. "*" is rejected in production.
CORS_ORIGINS=https://your-frontend.vercel.app

# Admin auth
# Generate with: npm run hash-password -- 'your-strong-password'
ADMIN_PASSWORD_HASH=
# 32+ random bytes, e.g. openssl rand -hex 32
ADMIN_JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=28800

# Customer identity — one of these is required in production.
# HS256 projects: the Supabase JWT secret. Asymmetric projects: the project URL (JWKS).
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Server-only key. Never expose to the browser. Used to persist the audit log.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp order numbers
WHATSAPP_NUMBER_1=9391798370
WHATSAPP_NUMBER_2=8317674764
